[Unit]
Description=Weekly verified Ozon database and report backup
After=postgresql.service
[Service]
Type=oneshot
User=ozon
Group=ozon
WorkingDirectory=/opt/ozon-analytics
EnvironmentFile=/etc/ozon-analytics/service.env
Environment=PYTHONPATH=/opt/ozon-analytics/src
ExecStart=/opt/ozon-analytics/.venv/bin/python -m ozon_analytics.cli backup
MemoryMax=256M
Nice=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/ozon-analytics
