SERVER_HOST=
SERVER_USER=root
SERVER_PASSWORD=
SSH_KEY_PATH=

OZON_CLIENT_ID=
OZON_API_KEY=

REPOSITORY_URL=https://github.com/daniil2022dol-bit/ANALITICA_OZON.git

OZON_PERFORMANCE_CLIENT_ID=
OZON_PERFORMANCE_CLIENT_SECRET=
OZON_PERFORMANCE_DOCS_URL=https://docs.ozon.ru/api/performance/

# Application: keep actual values only in protected .env / service.env.
DATABASE_URL=postgresql://ozon_app:CHANGE_ME@127.0.0.1:5432/ozon_analytics
WEB_DATABASE_URL=postgresql://ozon_web:CHANGE_ME@127.0.0.1:5432/ozon_analytics
ADMIN_USER=analytics
ADMIN_PASSWORD=
SESSION_SECRET=
SECURE_COOKIES=true
DATA_DIR=/opt/ozon-analytics/var
BACKUP_DIR=/var/backups/ozon-analytics
BACKUP_REMOTE=
RCLONE_CONFIG=
OZON_REQUEST_INTERVAL=5
OZON_DAILY_REQUEST_LIMIT=200
HISTORY_DAYS=14
REPLENISHMENT_LEAD_DAYS=14
SAFETY_STOCK_DAYS=7
